trading-bot/venv/
trading-bot/data/
trading-bot/results/
**/__pycache__/
logs/

# Repo restructured 2026-07-22 — .py files moved to root, but data/venv/
# results/ stay where they physically are (trading-bot/) and are also
# regenerable/re-copyable, not source. Root-level data/ is a copy used by
# the currently-configured DATA_DIR (config.py resolves relative to its own
# location, now root) — same reason as the old trading-bot/data/ entry above.
results/

# data/ used to be blanket-ignored (see history above), but the
# stock_daily/options_expiry/symbol-list pipeline (2026-07-24) is meant to
# be permanently committed to this repo, not just live on this server —
# so only the pieces that are NOT part of that pipeline stay ignored.
data/*
!data/nifty100_symbols.csv
!data/stock_daily/
!data/options_expiry/
